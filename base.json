{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeRequireAllStatusChecks",
    ":automergeAll",
    "helpers:pinGitHubActionDigests",
    "local>contentful/renovate-config:node",
    "local>contentful/renovate-config:terraformCloud",
    "local>contentful/renovate-config:groupESLintPrettier"
  ],
  "labels": ["dependencies", "renovate"],
  "prCreation": "not-pending",
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "2 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "2 days",
    "addLabels": ["security"]
  },
  "docker": {
    "pinDigests": true
  },
  "npm": {
    "enabled": true
  },
  "hostRules": [
    {
      "matchHost": "registry.npmjs.org",
      "hostType": "npm",
      "token": "{{ secrets.WHYDAH_GALLY_NPM_TOKEN }}"
    },
    {
      "matchHost": "npm.pkg.github.com",
      "hostType": "npm",
      "token": "{{ secrets.GITHUB_TOKEN }}"
    }
  ],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "description": "No minimum release age for trusted internal packages",
      "matchPackageNames": ["@contentful/cf-entities", "@contentful/contentful-models"],
      "minimumReleaseAge": null
    }
  ]
}
