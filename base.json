{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeRequireAllStatusChecks",
    ":automergeAll",
    "helpers:pinGitHubActionDigests",
    "local>contentful/renovate-config:node",
    "local>contentful/renovate-config:terraformCloud",
    "local>contentful/renovate-config:groupESLintPrettier"
  ],
  "labels": ["dependencies", "renovate"],
  "prCreation": "not-pending",
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "2 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "2 days",
    "addLabels": ["security"]
  },
  "docker": {
    "pinDigests": true
  },
  "npm": {
    "enabled": true
  },
  "hostRules": [
    {
      "matchHost": "registry.npmjs.org",
      "hostType": "npm",
      "token": "{{ secrets.WHYDAH_GALLY_NPM_TOKEN }}"
    },
    {
      "matchHost": "npm.pkg.github.com",
      "hostType": "npm",
      "token": "{{ secrets.GITHUB_TOKEN }}"
    },
    {
      "description": "Authenticate Docker Hub lookups to avoid the anonymous-pull rate limit (100 pulls/6hr per IP), which was causing intermittent 'no-result' lookup failures across many unrelated dependencies (docker, busybox, memcached, otel/opentelemetry-collector-contrib, etc. - see ACT-5072). Proven working in isolation on contentful/github-pr-linter (PR #1965) before landing here - see renovate-config#98 (reverted) / #100 (revert) for why that step mattered.",
      "hostType": "docker",
      "username": "{{ secrets.DOCKERHUB_USERNAME }}",
      "password": "{{ secrets.DOCKERHUB_TOKEN }}"
    }
  ],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "description": "No minimum release age for trusted internal packages",
      "matchPackageNames": ["@contentful/*"],
      "minimumReleaseAge": null
    }
  ]
}
