{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":preserveSemverRanges",
    ":automergeRequireAllStatusChecks",
    ":automergeAll",
    "local>contentful/renovate-config:pinNodeLTS",
    "local>contentful/renovate-config:terraformCloud",
    "local>contentful/renovate-config:githubPackages"
  ],
  "npm": {
    "enabled": false,
    "npmToken": "{{ secrets.WHYDAH_GALLY_NPM_TOKEN }}",
    "rangeStrategy": "bump"
  },

  "semanticCommits": "enabled",
  "packageRules": [
    {
      "description": "Disable Docker by default",
      "matchCategories": ["docker"],
      "enabled": false
    },
    {
      "description": "NodeJs bumps need Approval",
      "matchPackageNames": ["node"],
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "dependencyDashboardApproval": true
    }
  ]
}
