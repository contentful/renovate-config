{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":preserveSemverRanges",
    ":automergeRequireAllStatusChecks",
    ":automergeAll"
  ],
  "npm": {
    "enabled": false,
    "encrypted": {
      "npmToken": ""
    }
  },
  "docker": {
    "enabled": false
  },
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "matchPackageNames": ["cimg/node", "node"],
      "allowedVersions": "<= 18"
    }
  ]
}
