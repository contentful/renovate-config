{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":preserveSemverRanges",
    ":automergeRequireAllStatusChecks",
    ":automergeAll",
    "helpers:pinGitHubActionDigests",
    "local>contentful/renovate-config:node",
    "local>contentful/renovate-config:terraformCloud",
    "local>contentful/renovate-config:groupESLintPrettier",
    "local>contentful/renovate-config:updateTflint"
  ],
  "minimumReleaseAge": "15 days",
  "npm": {
    "enabled": false
  },
  "hostRules": [
    {
      "matchHost": "registry.npmjs.org",
      "hostType": "npm",
      "token": "{{ secrets.WHYDAH_GALLY_NPM_TOKEN }}"
    },
    {
      "matchHost": "npm.pkg.github.com",
      "hostType": "npm",
      "token": "{{ secrets.GITHUB_TOKEN }}"
    }
  ],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "matchUpdateTypes": ["major", "minor"],
      "matchPackageNames": ["postgres", "cimg/postgres"],
      "automerge": false
    }
  ]
}
