{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":preserveSemverRanges",
    ":automergeRequireAllStatusChecks",
    ":automergeAll",
    "local>contentful/renovate-config:pinNodeLTS",
    "local>contentful/renovate-config:terraformCloud",
    "local>contentful/renovate-config:githubPackages"
  ],
  "npm": {
    "platform": "github",
    "enabled": false,
    "encrypted": {
      "npmToken": ""
    },
    "rangeStrategy": "bump"
  },
  "docker": {
    "enabled": false
  },
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "description": "NodeJs bumps need Approval",
      "matchPackageNames": [
        "node"
      ],
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "engines"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}