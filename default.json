{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":preserveSemverRanges",
    ":automergeRequireAllStatusChecks",
    ":automergeAll",
    "local>contentful/renovate-config:pinNodeLTS",
    "local>contentful/renovate-config:terraformCloud",
    "local>contentful/renovate-config:groupESLintPrettier"
  ],
  "npm": {
    "enabled": false
  },
  "hostRules": [
    {
      "matchHost": "registry.npmjs.org",
      "hostType": "npm",
      "token": "{{ secrets.WHYDAH_GALLY_NPM_TOKEN }}"
    },
    {
      "matchHost": "npm.pkg.github.com",
      "hostType": "npm",
      "token": "{{ secrets.GITHUB_TOKEN }}"
    }
  ],
  "semanticCommits": "enabled",
  "regexManagers": [
    {
      "fileMatch": ["^\\.github/workflows/.+\\.ya?ml$"],
      "matchStrings": [
        "tflint_version:\\s*(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "terraform-linters/tflint",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "NodeJs bumps need Approval",
      "matchPackageNames": ["node"],
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "dependencyDashboardApproval": true
    },
    {
      "matchUpdateTypes": ["major", "minor"],
      "matchPackageNames": ["postgres", "cimg/postgres"],
      "automerge": false
    }
  ]
}
