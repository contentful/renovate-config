{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":preserveSemverRanges",
    ":automergeRequireAllStatusChecks",
    ":automergeAll",
    "local>contentful/renovate-config:pinNodeLTS",
    "local>contentful/renovate-config:terraformCloud"
  ],
  "npm": {
    "enabled": false
  },
  "hostRules": [
    {
      "matchHost": "registry.npmjs.org",
      "hostType": "npm",
      "token": "{{ secrets.WHYDAH_GALLY_NPM_TOKEN }}"
    }
  ],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "description": "NodeJs bumps need Approval",
      "matchPackageNames": ["node"],
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "dependencyDashboardApproval": true
    }
  ]
}
