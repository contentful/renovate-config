{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    // buildin presets
    ":preserveSemverRanges",
    ":automergeRequireAllStatusChecks",
    ":automergeAll",
    // contentful presets
    "local>contentful/renovate-config:maxNode18"

    // TIP: you can disable any preset by adding `"ignorePresets": [":presetName"]
  ],
  "npm": {
    "enabled": false,
    // Whydah-gally readonly npm token encrypted with Renovate public key
    "encrypted": {
      "npmToken": ""
    }
  },
  "docker": {
    "enabled": false
  },
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "description": "NodeJs bumps need Approval",
      "matchPackageNames": ["node"],
      "matchManagers": ["npm"],
      "matchDepTypes": [ "engines" ],
      "dependencyDashboardApproval": true
    },
  ]
}
