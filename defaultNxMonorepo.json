{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>contentful/renovate-config:base",
    "local>contentful/renovate-config:groupNxPluginAndWorkflows"
  ],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Run terraform updates on their own overnight schedule so provider-hash generation (large providers like hashicorp/aws stream ~500MB per build) doesn't share heap with the npm/pnpm resolution phase and OOM the microVM runner.",
      "matchManagers": ["terraform"],
      "schedule": ["after 2am and before 6am"]
    },
    {
      "description": "Cap terraform concurrency so at most two provider-hash jobs run at a time, further limiting peak heap on the runner.",
      "matchManagers": ["terraform"],
      "prConcurrentLimit": 2,
      "branchConcurrentLimit": 2
    },
    {
      "description": "NodeJs bumps need Approval",
      "matchPackageNames": ["node"],
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["*"],
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "widen"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["*"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "rangeStrategy": "bump"
    },
    {
      "description": "No minimum release age for trusted internal packages",
      "matchPackageNames": ["@contentful/nx", "@contentful/service-kit", "contentful/developer-platform", "contentful/assemblies"],
      "minimumReleaseAge": null
    }
  ]
}
