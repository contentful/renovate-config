{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Keep AI SDK packages synchronized",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@ai-sdk/*"],
      "groupName": "AI SDK packages"
    },
    {
      "description": "Keep Contentful Experience packages synchronized",
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^@contentful\\/experiences?-/"],
      "groupName": "Contentful Experience packages"
    },
    {
      "description": "Keep Contentful Field Editor packages synchronized",
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^@contentful\\/field-editor-/"],
      "groupName": "Contentful Field Editor packages"
    },
    {
      "description": "Keep Contentful Entitlements packages synchronized",
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^@contentful\\/entitlements-[a-z0-9._-]+$/"],
      "groupName": "Contentful Entitlements packages"
    },
    {
      "description": "Keep Contentful PubSub packages synchronized",
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^@contentful\\/pubsub-/"],
      "groupName": "Contentful PubSub packages"
    },
    {
      "description": "Keep Forma 36 packages synchronized",
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^@contentful\\/f36-/"],
      "groupName": "forma 36 packages"
    },
    {
      "description": "Keep Playwright packages synchronized",
      "matchPackageNames": [
        "@playwright/test",
        "playwright",
        "playwright-core",
        "mcr.microsoft.com/playwright"
      ],
      "groupName": "Playwright packages"
    },
    {
      "description": "Keep OpenTelemetry packages synchronized",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@opentelemetry/*"],
      "groupName": "OpenTelemetry packages"
    },
    {
      "description": "Keep Hapi ecosystem packages synchronized",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@hapi/*", "/^@contentful\\/hapi-/"],
      "groupName": "Hapi packages"
    }
  ]
}
