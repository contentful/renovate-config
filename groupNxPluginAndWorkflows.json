{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Migrate contentful/assemblies reusable workflow references to contentful/developer-platform when @contentful/nx is updated. See also https://contentful.atlassian.net/wiki/spaces/PROD/pages/6218252450/Thoughts+about+reusable+GitHub+workflows+Nx+Monorepos",
      "fileMatch": [
        "^\\.github/workflows/.+\\.ya?ml$"
      ],
      "matchStrings": [
        "(?<indentation>[ \\t]*)uses:\\s*contentful/(?:assemblies|developer-platform)/\\.github/workflows/(?<depType>[^@\\s]+)@(?<currentDigest>\\S+)\\s*#\\s*@contentful/nx@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "@contentful/nx",
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "contentful/developer-platform",
      "autoReplaceStringTemplate": "{{{indentation}}}uses: contentful/developer-platform/.github/workflows/{{{depType}}}@{{{newDigest}}} # @contentful/nx@{{{newValue}}}"
    }
  ],
  "packageRules": [
    {
      "description": "Strip @contentful/nx@ prefix from github-tags lookups for the @contentful/nx dep. Tags on contentful/developer-platform are shaped @contentful/nx@X.Y.Z (Nx monorepo release convention).",
      "matchDepNames": [
        "@contentful/nx"
      ],
      "matchDatasources": [
        "github-tags"
      ],
      "extractVersion": "^@contentful/nx@(?<version>.*)$"
    },
    {
      "description": "Disable github-actions manager for contentful/assemblies and contentful/developer-platform - the custom regex manager handles these with proper @contentful/nx version tracking",
      "matchPackageNames": [
        "contentful/assemblies",
        "contentful/developer-platform"
      ],
      "matchManagers": [
        "github-actions"
      ],
      "enabled": false
    },
    {
      "description": "Disable digest-only updates for contentful/assemblies and contentful/developer-platform - we only want to update when the @contentful/nx version changes",
      "matchPackageNames": [
        "contentful/assemblies",
        "contentful/developer-platform"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "enabled": false
    },
    {
      "groupName": "developer-platform monorepo",
      "matchPackageNames": [
        "@contentful/service-kit",
        "@contentful/nx",
        "contentful/assemblies",
        "contentful/developer-platform",
        "@contentful/eslint-plugin-service-kit"
      ],
      "matchDatasources": [
        "npm",
        "github-tags"
      ],
      "pinDigests": true,
      "separateMajorMinor": false,
      "labels": [
        "nx-migrate",
        "dependencies:nx"
      ]
    },
    {
      "groupName": "nx monorepo",
      "matchSourceUrls": [
        "https://github.com/nrwl/nx**"
      ],
      "labels": [
        "nx-migrate",
        "dependencies:nx"
      ]
    }
  ]
}
