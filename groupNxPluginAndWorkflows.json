{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "regexManagers": [
    {
      "customType": "regex",
      "description": "Update reusable workflow SHA references when @contentful/nx is updated. See also https://contentful.atlassian.net/wiki/spaces/PROD/pages/6218252450/Thoughts+about+reusable+GitHub+workflows+Nx+Monorepos",
      "fileMatch": ["^\\.github/workflows/.+\\.ya?ml$"],
      "matchStrings": [
        "uses:\\s*contentful/(?<repo>[^/]+)/\\.github/workflows/(?<workflow>[^@]+)@(?<currentDigest>\\S+)\\s*#\\s*@contentful/nx@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "@contentful/nx",
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "contentful/{{{repo}}}",
      "extractVersionTemplate": "^@contentful/nx@(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Disable github-actions manager for contentful/assemblies and contentful/developer-platform - the custom regex manager handles these with proper @contentful/nx version tracking",
      "matchPackageNames": ["contentful/assemblies", "contentful/developer-platform"],
      "matchManagers": ["github-actions"],
      "enabled": false
    },
    {
      "description": "Disable digest-only updates for contentful/assemblies and contentful/developer-platform - we only want to update when the @contentful/nx version changes",
      "matchPackageNames": ["contentful/assemblies", "contentful/developer-platform"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "groupName": "developer-platform monorepo",
      "matchPackageNames": ["@contentful/service-kit", "@contentful/nx", "contentful/assemblies", "contentful/developer-platform", "@contentful/eslint-plugin-service-kit"],
      "matchDatasources": ["npm", "github-tags"],
      "pinDigests": true,
      "labels": ["nx-migrate", "dependencies:nx"]
    },
    {
      "groupName": "nx monorepo",
      "matchSourceUrls": [
        "https://github.com/nrwl/nx**",
      ],
      "labels": ["nx-migrate", "dependencies:nx"]
    }
  ]
}
