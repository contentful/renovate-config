{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "NodeJs major bumps need Approval",
      "matchPackageNames": ["cimg/node", "node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Group all Node.js updates into one PR",
      "matchPackageNames": ["cimg/node", "node", "@types/node"],
      "groupName": "Node.js"
    },
    {
      "description": "Keep Nodejs at 24",
      "matchPackageNames": ["cimg/node", "node", "@types/node"],
      "allowedVersions": "<= 24"
    },
    {
      "description": "Bypass minimumReleaseAge for Node.js releases fixing CVE-2026-111497 (WIZ-ADV-2026-191)",
      "matchPackageNames": ["node", "cimg/node"],
      "matchNewValue": "/^v?(22\\.23\\.4|24\\.22\\.1|26\\.12\\.1)(-.+)?$/",
      "minimumReleaseAge": null
    }
  ]
}
