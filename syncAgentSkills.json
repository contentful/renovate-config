{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Regenerate repository-shared Agents Kit skills after Agents Kit or Contentful skill package upgrades",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@contentful/agents-kit", "@contentful/*skill*"],
      "groupName": "agents-kit",
      "skipInstalls": false,
      "postUpgradeTasks": {
        "commands": [
          "./node_modules/.bin/contentful-agents-kit skills install --allow-destructive"
        ],
        "executionMode": "branch",
        "fileFilters": ["skills/**", ".agents/**", ".claude/**", ".cursor/**"]
      }
    },
    {
      "description": "Temporarily pause pnpm skill regeneration pending CAO-475",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@contentful/agents-kit", "@contentful/*skill*"],
      "matchFileNames": ["pnpm-lock.yaml"],
      "postUpgradeTasks": {
        "commands": []
      }
    }
  ]
}
