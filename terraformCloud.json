{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "hostRules": [
    {
      "matchHost": "https://app.terraform.io",
      "token": "{{ secrets.TFE_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "description": "No minimum release age for trusted internal Terraform modules",
      "matchDatasources": ["terraform-module"],
      "matchPackageNames": ["app.terraform.io/contentful/**"],
      "minimumReleaseAge": null
    },
    {
      "description": "Require manual approval for Terraform updates",
      "matchCategories": ["terraform"],
      "automerge": false
    }
  ]
}
